---
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CookieBanner from "@components/CookieBanner.astro";
import SEO from "@components/SEO.astro";
import { SITE } from "@lib/site";
import type { SEOProps } from "@lib/seo";

type Props = SEOProps & { jsonLd?: object[]; class?: string };

const { class: bodyClass = "", ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <!-- Brand asset pack (v02 · "the sparkle") . SVG favicon + maskable PWA icons -->
    <link rel="icon" type="image/svg+xml" href="/brand/lyrava-favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/lyrava-apple-touch.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <SEO {...seo} />

    <!--
      ============================================================
      Analytics. IDs live in src/lib/site.ts.

      GA4 uses Google Consent Mode v2: defaults to denied for
      ad/analytics/personalisation storage so the script can load
      pre-consent (collects only basic anonymous pings) and
      "upgrades" to full tracking after the user clicks Accept on
      the cookie banner. This keeps us compliant with UK/EU GDPR
      while still measuring traffic.

      Clarity is gated entirely on consent — it doesn't load until
      Accept fires, so no recordings or heatmaps happen pre-consent.
      ============================================================
    -->
    {SITE.analytics.ga4MeasurementId && (
      <>
        <script is:inline>
          // 1. Consent Mode v2 defaults — must run BEFORE gtag.js loads
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            functionality_storage: 'granted',
            security_storage: 'granted',
            wait_for_update: 500
          });

          // If user previously accepted, restore consent immediately.
          try {
            if (localStorage.getItem('lyrava-cookie-consent') === 'accept') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted'
              });
            }
          } catch (e) { /* localStorage blocked — stay in denied state */ }
        </script>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.ga4MeasurementId}`}
        ></script>
        <script is:inline define:vars={{ id: SITE.analytics.ga4MeasurementId }}>
          gtag('js', new Date());
          gtag('config', id, { anonymize_ip: true });
        </script>
      </>
    )}
    {SITE.analytics.clarityProjectId && (
      <script is:inline define:vars={{ id: SITE.analytics.clarityProjectId }}>
        // Clarity loads only after user accepts cookies (no pre-consent recording).
        function loadClarity(){
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", id);
        }
        try {
          if (localStorage.getItem('lyrava-cookie-consent') === 'accept') loadClarity();
        } catch (e) {}
        window.addEventListener('lyrava:cookie-consent', function(e){
          if (e.detail === 'accept') loadClarity();
        });
      </script>
    )}
  </head>

  <body class:list={["min-h-screen flex flex-col", bodyClass]}>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <CookieBanner />

    <!-- Global IntersectionObserver: any element with class "reveal" fades up on scroll -->
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) {
          document.querySelectorAll(".reveal").forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
        document.querySelectorAll(".reveal").forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
