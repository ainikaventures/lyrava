---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SparkBackdrop from "@components/SparkBackdrop.astro";
import CTACard from "@components/CTACard.astro";
import FAQ from "@components/FAQ.astro";
import { SERVICES } from "@lib/site";

const seo = {
  title: "Services — Automation, AI Agents & Workflow Consultancy",
  description:
    "Four focused automation services for UK and US teams: business process automation, AI agents and chatbots, marketing and sales ops, and web/data scraping pipelines.",
  path: "/services",
  keywords: [
    "automation services",
    "workflow automation services",
    "AI agent development",
    "marketing automation consultancy",
    "data pipeline consultancy",
  ],
};

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services" },
];

const generalFaqs = [
  {
    question: "How do I know which service I actually need?",
    answer:
      "Most clients start with the pillar that's costing the most senior time today. Book a free call — we'll spend 30 minutes mapping your highest-friction process and tell you which (if any) of the four pillars is the right starting point. Sometimes the answer is \"none of them, you need a different tool first\" — we'll say that too.",
  },
  {
    question: "Can you work across more than one of the four services?",
    answer:
      "Yes — most engagements touch two or three. A typical example: build the CRM (marketing & sales), wire it into invoicing and onboarding (process automation), and add an AI agent that drafts proposals from past closed-won deals.",
  },
  {
    question: "Are you UK-based or US-based?",
    answer:
      "We're a distributed team covering both time zones. Discovery calls and standups in either UK or US working hours; async on Slack/Notion in between. Contracts can be signed under UK or US entities depending on your preference.",
  },
  {
    question: "What size companies do you typically work with?",
    answer:
      "10–500 employee teams are our sweet spot — large enough that manual ops are a real cost, small enough that we can ship something meaningful in weeks. We sometimes take on smaller engagements if the use case is well-defined; enterprise scopes go through a longer pre-sales process.",
  },
  {
    question: "What's the smallest engagement you'll take?",
    answer:
      "A two-day paid audit (£1,500 / $2,000). You leave with a process map, a prioritised opportunity list, and a fixed quote for the build. No obligation to proceed.",
  },
];
---

<BaseLayout {...seo}>
  <section class="relative isolate overflow-hidden">
    <SparkBackdrop subtle={true} />
    <div class="container-wide pt-12 pb-20 md:pt-16 md:pb-28">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mx-auto mt-10 max-w-3xl text-center">
        <span class="eyebrow reveal">
          <span class="h-1.5 w-1.5 rounded-full bg-glow-400 shadow-[0_0_8px_rgba(255,217,138,0.6)]"></span>
          What we do
        </span>
        <h1 class="reveal mt-6 text-display-xl text-balance text-cloud">
          Four pillars.
          <span class="gradient-text italic">One outcome.</span>
        </h1>
        <p class="reveal mt-6 text-pretty text-lg text-cloud/75 md:text-xl">
          Lyrava is a focused automation agency. We don't do website redesigns, we don't
          do paid media, we don't do "AI strategy" decks. We build the workflows, agents,
          pipelines, and CRM plumbing that compound — and we measure ourselves on hours
          returned to your team.
        </p>
      </div>
    </div>
  </section>

  <Section padding="lg">
    <ul class="grid gap-5 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <li class="reveal" style={`transition-delay:${i * 60}ms`}>
          <a href={`/services/${s.slug}`} class="card group block h-full">
            <div class="flex items-start justify-between gap-4">
              <div
                class="flex h-11 w-11 items-center justify-center rounded-lg border border-starlight-200/15 bg-starlight-200/[0.04] text-starlight-200"
                style="filter: drop-shadow(0 0 6px rgba(254,249,231,0.18))"
              >
                <svg width="20" height="20" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
                  <path d="M50 0 L52 48 L100 50 L52 52 L50 100 L48 52 L0 50 L48 48 Z" />
                </svg>
              </div>
              <span class="text-xs uppercase tracking-[0.18em] text-cloud/40">0{i + 1}</span>
            </div>

            <h2 class="mt-6 text-2xl text-balance text-cloud">{s.title}</h2>
            <p class="mt-3 text-pretty text-cloud/70">{s.blurb}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {s.keywords.map((k) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-cloud/60">{k}</span>
              ))}
            </div>

            <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-starlight-200 transition-transform group-hover:translate-x-1">
              Explore service
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section padding="md">
    <FAQ faqs={generalFaqs} title="Common questions" />
  </Section>

  <Section padding="xl">
    <CTACard />
  </Section>
</BaseLayout>
