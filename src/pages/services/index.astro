---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SparkBackdrop from "@components/SparkBackdrop.astro";
import SparkMark from "@components/SparkMark.astro";
import CTACard from "@components/CTACard.astro";
import FAQ from "@components/FAQ.astro";
import { SERVICES } from "@lib/site";

const seo = {
  title: "Services: automation, AI agents and workflow consultancy · lyrava",
  description:
    "Four focused automation services for UK and US teams: business process automation, AI agents and chatbots, marketing and sales ops, and web and data scraping pipelines.",
  path: "/services",
  keywords: [
    "automation services",
    "workflow automation services",
    "AI agent development",
    "marketing automation consultancy",
    "data pipeline consultancy",
  ],
};

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services" },
];

const generalFaqs = [
  {
    question: "How do I know which service I actually need?",
    answer:
      "Most clients start with the area that's costing the most senior time today. Book a free call. We'll spend 30 minutes mapping your highest-friction process and tell you which (if any) of the four areas is the right starting point. Sometimes the answer is 'none of them, you need a different tool first.' We'll say that too.",
  },
  {
    question: "Can you work across more than one of the four services?",
    answer:
      "Yes. Most engagements touch two or three. A typical example: build the CRM (marketing and sales), wire it into invoicing and onboarding (process automation), and add an AI agent that drafts proposals from past closed-won deals.",
  },
  {
    question: "Are you UK-based or US-based?",
    answer:
      "We're a distributed team covering both time zones. Discovery calls and standups in either UK or US working hours; async on Slack and Notion in between. Delivery happens primarily from our team in India. Contracts can be signed under UK or US entities depending on your preference.",
  },
  {
    question: "What size companies do you typically work with?",
    answer:
      "10 to 500 employees is our sweet spot. Large enough that manual ops are a real cost, small enough that we can ship something meaningful in weeks. We sometimes take smaller engagements if the use case is well-defined. Enterprise scopes go through a longer pre-sales process.",
  },
  {
    question: "What's the smallest engagement you'll take?",
    answer:
      "A two-day paid audit (£1,500 / $2,000). You leave with a process map, an opportunity list ranked by ROI, and a fixed quote for the build. No obligation to proceed.",
  },
];
---

<BaseLayout {...seo}>
  <section class="relative isolate overflow-hidden">
    <SparkBackdrop subtle={true} />
    <div class="container-wide pt-12 pb-20 md:pt-16 md:pb-28">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mx-auto mt-10 max-w-3xl text-center">
        <span class="eyebrow reveal">
          <span class="h-1.5 w-1.5 rounded-full bg-halo shadow-[0_0_8px_rgba(245,211,138,0.6)]"></span>
          What we do
        </span>
        <h1 class="reveal mt-6 text-display-xl text-balance text-paper">
          Four practices.
          <span class="gradient-text">One outcome.</span>
        </h1>
        <p class="reveal mt-6 text-pretty text-lg text-paper/75 md:text-xl">
          lyrava is a focused automation agency. We don't do website redesigns. We don't
          do paid media. We don't do "AI strategy" decks. We build the workflows,
          agents, pipelines and CRM plumbing that compound, and we measure ourselves
          on hours returned to your team.
        </p>
      </div>
    </div>
  </section>

  <Section padding="lg">
    <ul class="grid gap-5 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <li class="reveal" style={`transition-delay:${i * 60}ms`}>
          <a href={`/services/${s.slug}`} class="card group block h-full">
            <div class="flex items-start justify-between gap-4">
              <div
                class="flex h-11 w-11 items-center justify-center rounded-lg border border-halo-soft/15 bg-halo-soft/[0.04] text-halo-soft"
                style="filter: drop-shadow(0 0 6px rgba(254,249,231,0.18))"
              >
                <SparkMark size={20} />
              </div>
              <span class="eyebrow-mono text-paper/40">0{i + 1}</span>
            </div>

            <h2 class="mt-6 text-2xl text-balance text-paper">{s.title}</h2>
            <p class="mt-3 text-pretty text-paper/70">{s.blurb}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {s.keywords.map((k) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-paper/60">{k}</span>
              ))}
            </div>

            <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-halo-soft transition-transform group-hover:translate-x-1">
              Read more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section padding="md">
    <FAQ faqs={generalFaqs} title="Common questions" />
  </Section>

  <Section padding="xl">
    <CTACard />
  </Section>
</BaseLayout>
