---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import ServiceHero from "@components/ServiceHero.astro";
import Steps from "@components/Steps.astro";
import ToolGrid from "@components/ToolGrid.astro";
import UseCaseList from "@components/UseCaseList.astro";
import FAQ from "@components/FAQ.astro";
import CTACard from "@components/CTACard.astro";
import { serviceSchema } from "@lib/seo";

const slug = "business-process-automation";
const title = "Business Process & Workflow Automation";
const description =
  "Stop paying senior people to copy-paste between SaaS tools. We design and build the Zapier, Make, n8n, and Power Automate workflows that take invoices, onboarding, and approvals off your team's plate — with proper error handling, logging, and runbooks.";

const seo = {
  title: `${title} — lyrava`,
  description:
    "UK and US business process automation agency. We build Zapier, Make, n8n, and Power Automate workflows that compound — invoice processing, onboarding, approval routing, document workflows.",
  path: `/services/${slug}`,
  keywords: [
    "business process automation agency",
    "workflow automation services",
    "Zapier consultant",
    "Make consultant",
    "n8n consultant",
    "Power Automate consultant",
  ],
  jsonLd: [serviceSchema({ name: title, description, slug })],
};

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services" },
  { name: "Business Process Automation", href: `/services/${slug}` },
];

const steps = [
  {
    title: "Audit before automating",
    body: "We map the process end-to-end across people, tools, and inputs. Half the wins come from killing steps, not connecting them — we'll show you which ones to delete before we wire anything up.",
  },
  {
    title: "Pick the right tier of tool",
    body: "Zapier when speed matters and the workflow is short. Make for branching logic and bigger data. n8n (self-hosted) when you need control, scale, or compliance. We'll tell you which — and why — before we build.",
  },
  {
    title: "Build with real error handling",
    body: "Every workflow ships with retries, idempotency keys where it matters, alerting to Slack or email when something fails, and a runbook your team can follow without us.",
  },
  {
    title: "Hand it over, properly",
    body: "Credentials in your name. Documentation in your wiki. A 30-minute Loom walking your team through what to do when something breaks. You can fire us tomorrow and nothing stops working.",
  },
];

const tools = [
  { name: "Zapier", tag: "speed & breadth" },
  { name: "Make", tag: "branching logic" },
  { name: "n8n", tag: "self-hosted" },
  { name: "Power Automate", tag: "Microsoft stack" },
  { name: "Airtable", tag: "ops database" },
  { name: "Notion", tag: "docs + workflows" },
  { name: "Google Workspace", tag: "Apps Script" },
  { name: "Slack", tag: "approvals + alerts" },
  { name: "Stripe", tag: "billing flows" },
  { name: "Xero / QuickBooks", tag: "accounting" },
  { name: "DocuSign", tag: "signature workflows" },
  { name: "Custom code", tag: "when it earns it" },
];

const cases = [
  {
    metric: "11.5h",
    metricLabel: "Saved per week",
    title: "Invoice processing for a UK accountancy",
    context:
      "A 22-person practice was spending 12 hours per week downloading client invoices, renaming files, and entering them into Xero by hand.",
    outcome:
      "We built a Make scenario that pulls invoices from inboxes and shared drives, OCRs them, matches the supplier, and pushes draft bills into Xero with the right tax codes. The bookkeeper now spends 30 minutes per week reviewing exceptions.",
  },
  {
    metric: "3 days → same day",
    metricLabel: "Onboarding cycle time",
    title: "Client onboarding for a US marketing agency",
    context:
      "A 40-person agency was losing the first three days of every engagement to a sequence of forms, contracts, intro emails, Slack invites, and folder creation handled by an over-stretched ops manager.",
    outcome:
      "A single intake form in HubSpot now triggers a Zapier sequence that fires the contract via PandaDoc, provisions the Slack channel, creates the Google Drive folder structure, schedules the kickoff in Calendly, and posts the welcome message — all before the new client refreshes their email.",
  },
  {
    metric: "~$80k/yr",
    metricLabel: "Operational cost saved",
    title: "Approval routing for a 200-person SaaS",
    context:
      "Procurement requests bounced between three approvers in email, with no audit trail, no SLA, and a heroic ops lead chasing approvals on Slack.",
    outcome:
      "We replaced the email chain with an n8n workflow on top of an Airtable approvals table, with role-based routing, automatic reminders after 48 hours, and a single dashboard the CFO actually checks. Approval times dropped from a median of 9 days to 1.5 days.",
  },
];

const faqs = [
  {
    question: "What's the difference between Zapier, Make, and n8n?",
    answer:
      "<strong>Zapier</strong> is the fastest to ship and has the widest catalogue of integrations — best when the workflow is short and you'd rather not run infrastructure. <strong>Make</strong> (formerly Integromat) gives you visual branching, error routes, and much cheaper pricing at higher volumes — best for anything with conditional logic. <strong>n8n</strong> is self-hostable and open source — best when you need full control over your data, want to avoid per-task pricing, or have compliance requirements that rule out third-party platforms. We'll recommend whichever is right for your stack and budget; we have no financial relationship with any of them.",
  },
  {
    question: "Will this break when our SaaS apps update their APIs?",
    answer:
      "Sometimes — APIs do change. That's why every workflow we ship includes monitoring, automatic failure alerts, and a documented runbook. If you're on a retainer, we cover the fix. If you're not, you can fix most issues yourself in under 30 minutes using the runbook, or send us a one-off ticket.",
  },
  {
    question: "Who owns the credentials and accounts?",
    answer:
      "You do. Always. We connect to <em>your</em> Zapier / Make / n8n account using <em>your</em> SaaS credentials. When the project ends, we hand back full admin access and remove ours. No vendor lock-in by accident.",
  },
  {
    question: "How do you handle errors and edge cases?",
    answer:
      "Every workflow has error handling baked in: retries with exponential backoff for transient failures, dead-letter handling for malformed inputs, idempotency keys on operations that shouldn't run twice, and Slack/email alerts when something needs human attention. We also write a one-page \"what to do when X breaks\" runbook for each workflow.",
  },
  {
    question: "Do we need engineering involvement on our side?",
    answer:
      "Usually no — that's the whole point. Most of the tools we use are no-code or low-code. Where custom code <em>is</em> needed (an API without an off-the-shelf connector, complex data transformation), we write and host it ourselves. Your engineers are looped in for credentials and for the security review, and that's it.",
  },
  {
    question: "How long does a typical first build take?",
    answer:
      "From signed contract to live workflow: usually two weeks. The first half is the audit and design (we don't build anything until you've signed off the process map and the success metric). The second half is build, test, document, and hand over.",
  },
];
---

<BaseLayout {...seo}>
  <ServiceHero
    eyebrow="Process automation"
    title="Stop paying senior people"
    accent="to copy-paste."
    lede="The average mid-sized team loses 15–20% of operational hours to work that already lives inside the SaaS tools they're paying for — it just isn't connected. We connect it."
    breadcrumbs={breadcrumbs}
  />

  <Section padding="md">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <span class="eyebrow">The problem</span>
        <h2 class="mt-4 text-display-lg text-balance">
          Your tools work. The
          <span class="text-halo-soft">handoffs between them</span>
          don't.
        </h2>
      </div>
      <div class="lg:col-span-7 space-y-5 text-paper/75 text-pretty">
        <p>
          Every growing business hits the same wall. The CRM is fine. The accounting
          tool is fine. The project management tool is fine. But invoices arrive in
          email, get downloaded by hand, renamed, uploaded somewhere, then keyed into
          accounting. New clients fill out a form, then someone manually creates the
          Slack channel, the Drive folder, the contract, and the kickoff invite.
          Approvals happen in DMs that no one can audit.
        </p>
        <p>
          Each of these handoffs costs five minutes. Multiply by ten people, ten
          times a day, fifty weeks a year, and you're paying for a full-time job
          you didn't realise you'd hired. Worse, the work is invisible — until
          someone leaves and the institutional knowledge leaves with them.
        </p>
        <p>
          Process automation isn't about replacing people. It's about ending the
          conditions where senior people quietly drown in clerical work.
        </p>
      </div>
    </div>
  </Section>

  <Section padding="md">
    <Steps
      steps={steps}
      title="How we solve it"
      blurb="Four phases. Two weeks for the first workflow in production. Then we keep going if it's working — and stop if it's not."
    />
  </Section>

  <Section padding="md">
    <ToolGrid
      tools={tools}
      title="Tools we work in"
      blurb="We're tool-agnostic. We pick what fits your team's existing stack, your data sensitivity, and your budget — and we'll happily push back on a brief that demands a specific platform when something else is the better fit."
    />
  </Section>

  <Section padding="md">
    <UseCaseList cases={cases} />
  </Section>

  <Section padding="md">
    <FAQ faqs={faqs} />
  </Section>

  <Section padding="xl">
    <CTACard
      title="Find out what your team's manual hours are actually costing."
      body="A two-day paid audit gives you a process map, a prioritised list of automations ranked by ROI, and a fixed quote for the build. £1,500 / $2,000. Roll the audit fee into the build if you decide to proceed."
    />
  </Section>
</BaseLayout>
