---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import SparkBackdrop from "@components/SparkBackdrop.astro";
import SparkMark from "@components/SparkMark.astro";
import { SERVICES, SITE } from "@lib/site";

const seo = {
  title: "lyrava — Automation, AI Agents & Workflow Consultancy (UK & USA)",
  description:
    "lyrava is a business process automation agency helping UK and US teams ship Zapier, Make, n8n, and AI agent builds that actually save hours — not just dashboards.",
  path: "/",
  keywords: [
    "business process automation agency",
    "AI automation consultancy UK",
    "AI automation consultancy USA",
    "workflow automation services",
    "AI agent development",
    "Zapier consultant",
    "Make consultant",
    "n8n consultant",
  ],
};

const metrics = [
  { value: "120+", label: "Workflows shipped" },
  { value: "30%", label: "Avg ops cost cut" },
  { value: "<2 wk", label: "Typical first build" },
  { value: "UK + US", label: "Time-zone coverage" },
];

const principles = [
  {
    title: "Audit before automating",
    body: "We map the process end-to-end before touching a tool. Half the wins come from killing steps, not connecting them.",
  },
  {
    title: "Boring tech where it counts",
    body: "Zapier and Make for speed. n8n and code for scale. AI only where it earns its keep — not because it's trendy.",
  },
  {
    title: "Owned by you, not us",
    body: "Every build comes with a runbook, observability, and the credentials in your name. No vendor lock-in by accident.",
  },
  {
    title: "Measured in hours saved",
    body: "We agree the metric upfront and report against it monthly. If a workflow isn't paying back, we rebuild or retire it.",
  },
];
---

<BaseLayout {...seo}>
  <!-- ============================================================ HERO -->
  <section class="relative isolate overflow-hidden">
    <SparkBackdrop />
    <div class="container-wide pt-20 pb-24 md:pt-28 md:pb-32 lg:pt-36 lg:pb-40">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow reveal">
          <span class="h-1.5 w-1.5 rounded-full bg-halo shadow-[0_0_8px_rgba(245,211,138,0.6)]"></span>
          Automation agency · UK &amp; USA
        </span>

        <h1 class="reveal mt-6 text-display-2xl text-balance text-paper">
          Build the quiet
          <span class="gradient-text">automations</span>
          that move your business.
        </h1>

        <p class="reveal mt-7 text-pretty text-lg text-paper/75 md:text-xl">
          lyrava designs and ships the workflows, AI agents, and revenue-ops plumbing
          that turn manual hours into compounding leverage — for ambitious teams in
          London, New York, and everywhere in between.
        </p>

        <div class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">
            Book a discovery call
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/services" class="btn-secondary">
            See what we build
          </a>
        </div>

        <p class="reveal mt-6 eyebrow-mono text-paper/45">
          Free 30-minute scoping call · No commitment
        </p>
      </div>

      <!-- Metrics strip -->
      <dl class="reveal mx-auto mt-20 grid max-w-4xl grid-cols-2 gap-y-8 sm:grid-cols-4 sm:gap-6">
        {metrics.map((m) => (
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 eyebrow-mono text-paper/55">
              {m.label}
            </dt>
            <dd class="order-1 font-display text-4xl text-halo-soft md:text-5xl">
              {m.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="divider-line"></div>

  <!-- ============================================================ SERVICES -->
  <Section id="services" padding="lg">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow reveal">What we do</span>
      <h2 class="reveal mt-5 text-display-lg text-balance">
        Four pillars. One outcome:
        <span class="text-halo-soft">fewer manual hours.</span>
      </h2>
      <p class="reveal mx-auto mt-5 max-w-prose text-pretty text-paper/70">
        We focus where automation has the highest leverage — and we say no to the rest.
        Pick the pillar that's costing you the most time today; we'll start there.
      </p>
    </div>

    <ul class="mt-16 grid gap-5 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <li class="reveal" style={`transition-delay:${i * 60}ms`}>
          <a href={`/services/${s.slug}`} class="card group block h-full">
            <div class="flex items-start justify-between gap-4">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-halo-soft/15 bg-halo-soft/[0.04] text-halo-soft"
                style="filter: drop-shadow(0 0 6px rgba(254,249,231,0.18))"
              >
                <SparkMark size={18} />
              </div>
              <span class="eyebrow-mono text-paper/40">
                0{i + 1}
              </span>
            </div>

            <h3 class="mt-6 text-2xl text-balance text-paper">{s.title}</h3>
            <p class="mt-3 text-pretty text-paper/70">{s.blurb}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {s.keywords.map((k) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-paper/60">
                  {k}
                </span>
              ))}
            </div>

            <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-halo-soft transition-transform group-hover:translate-x-1">
              Explore service
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <div class="divider-line"></div>

  <!-- ============================================================ APPROACH -->
  <Section id="approach" padding="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <span class="eyebrow reveal">How we work</span>
        <h2 class="reveal mt-5 text-display-lg text-balance">
          We're not another
          <span class="text-halo-soft">"AI transformation"</span> deck.
        </h2>
        <p class="reveal mt-5 text-pretty text-paper/70">
          lyrava is small, opinionated, and senior. You work with the people doing the
          building — no account managers, no offshore handoffs, no PowerPoint inflation.
          We measure ourselves on hours returned to your team, not slides delivered.
        </p>
        <a href="/about" class="reveal mt-8 inline-flex items-center gap-2 text-sm font-medium text-halo-soft hover:underline underline-offset-4">
          More about how we operate
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-4 sm:grid-cols-2">
          {principles.map((p, i) => (
            <li
              class="reveal rounded-2xl border border-white/[0.07] bg-white/[0.02] p-6"
              style={`transition-delay:${i * 80}ms`}
            >
              <div class="flex h-8 w-8 items-center justify-center rounded-md border border-halo-soft/15 bg-halo-soft/[0.06] font-display text-halo-soft">
                {i + 1}
              </div>
              <h3 class="mt-4 text-lg text-paper">{p.title}</h3>
              <p class="mt-2 text-sm text-pretty text-paper/65">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <div class="divider-line"></div>

  <!-- ============================================================ PROCESS -->
  <Section id="process" padding="lg">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow reveal">The engagement</span>
      <h2 class="reveal mt-5 text-display-lg text-balance">
        From scoping call to shipped workflow in
        <span class="text-halo-soft">weeks, not quarters.</span>
      </h2>
    </div>

    <ol class="relative mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-3">
      {[
        {
          step: "Discover",
          time: "Week 1",
          body: "30-minute call, then a paid two-day audit. You leave with a process map, a prioritised opportunity list, and a fixed quote.",
        },
        {
          step: "Build",
          time: "Weeks 2–3",
          body: "We ship the first automation in production. You see live runs, error handling, and a runbook before we ever invoice for build time.",
        },
        {
          step: "Compound",
          time: "Ongoing",
          body: "Optional retainer to monitor, extend, and absorb the next wave. Pause or cancel any month — you keep everything.",
        },
      ].map((p, i) => (
        <li class="reveal card" style={`transition-delay:${i * 80}ms`}>
          <div class="flex items-baseline justify-between">
            <span class="font-display text-3xl gradient-text-glow">0{i + 1}</span>
            <span class="eyebrow-mono text-paper/45">{p.time}</span>
          </div>
          <h3 class="mt-4 text-xl text-paper">{p.step}</h3>
          <p class="mt-2 text-pretty text-paper/70">{p.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ============================================================ CTA -->
  <Section padding="xl">
    <div class="reveal relative overflow-hidden rounded-3xl border border-halo-soft/15 bg-gradient-to-br from-nocturne-lift via-ink to-nocturne-deep p-10 md:p-16">
      <div aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-halo-soft/[0.08] blur-3xl"></div>
      <div aria-hidden="true" class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-halo/[0.08] blur-3xl"></div>

      <div class="relative mx-auto max-w-2xl text-center">
        <h2 class="text-display-lg text-balance">
          Ready to see where your team is bleeding hours?
        </h2>
        <p class="mt-5 text-pretty text-paper/75">
          Book a free 30-minute call. We'll review one process you'd love to automate
          and tell you — honestly — whether it's worth doing, what it would cost, and what we'd build.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">Book a discovery call</a>
          <a href={`mailto:${SITE.email}`} class="btn-secondary">
            Or email us directly
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
