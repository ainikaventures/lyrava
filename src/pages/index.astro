---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import SparkBackdrop from "@components/SparkBackdrop.astro";
import SparkMark from "@components/SparkMark.astro";
import { SERVICES, SITE } from "@lib/site";

const seo = {
  title: "lyrava: automation, AI agents and workflow consultancy for UK and US teams",
  description:
    "lyrava is an automation and AI agency working with teams in the UK and US. Zapier, Make, n8n, AI agents, CRM and data pipelines. Delivered from India, governed in the UK.",
  path: "/",
  keywords: [
    "business process automation agency",
    "AI automation consultancy UK",
    "AI automation consultancy USA",
    "workflow automation services",
    "AI agent development",
    "Zapier consultant",
    "Make consultant",
    "n8n consultant",
  ],
};

const metrics = [
  { value: "120+", label: "Workflows shipped" },
  { value: "30%", label: "Avg ops cost cut" },
  { value: "<2 wk", label: "Typical first build" },
  { value: "UK + US", label: "Time-zone coverage" },
];

const principles = [
  {
    title: "Map the work first",
    body: "We sit with your team for a day or two and write down what actually happens. Half the time, the answer isn't more automation. It's removing steps that shouldn't be there in the first place.",
  },
  {
    title: "Use the right tool for the job",
    body: "Zapier when you need to ship this week. Make when there's branching logic. n8n or custom code when you need control or scale. We pick based on your stack and budget, not what's trendy.",
  },
  {
    title: "You own everything we build",
    body: "Credentials in your name. Documentation in your wiki. A short Loom showing your team how to fix things if they break. End the relationship tomorrow and nothing stops working.",
  },
  {
    title: "Hours saved is the metric",
    body: "We agree the number upfront and report against it every month. If something we built isn't paying back, we rebuild it or shut it down. We won't keep billing for work that doesn't earn.",
  },
];
---

<BaseLayout {...seo}>
  <!-- HERO ============================================================ -->
  <section class="relative isolate overflow-hidden">
    <SparkBackdrop />
    <div class="container-wide pt-20 pb-24 md:pt-28 md:pb-32 lg:pt-36 lg:pb-40">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow reveal">
          <span class="h-1.5 w-1.5 rounded-full bg-halo shadow-[0_0_8px_rgba(245,211,138,0.6)]"></span>
          Automation agency · UK and US
        </span>

        <h1 class="reveal mt-6 text-display-2xl text-balance text-paper">
          Build the quiet
          <span class="gradient-text">automations</span>
          that move your business.
        </h1>

        <p class="reveal mt-7 text-pretty text-lg text-paper/75 md:text-xl">
          We design and build the workflows, AI agents and CRM plumbing that take
          repetitive work off your team's plate. Small projects in two weeks, bigger
          ones in a quarter. Delivered from India, governed in the UK.
        </p>

        <div class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">
            Book a discovery call
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/services" class="btn-secondary">See what we build</a>
        </div>

        <p class="reveal mt-6 eyebrow-mono text-paper/45">
          Free 30-minute call · No commitment
        </p>
      </div>

      <!-- Metrics strip -->
      <dl class="reveal mx-auto mt-20 grid max-w-4xl grid-cols-2 gap-y-8 sm:grid-cols-4 sm:gap-6">
        {metrics.map((m) => (
          <div class="flex flex-col items-center text-center">
            <dt class="order-2 mt-2 eyebrow-mono text-paper/55">{m.label}</dt>
            <dd class="order-1 font-display text-4xl text-halo-soft md:text-5xl">
              {m.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="divider-line"></div>

  <!-- SERVICES ======================================================== -->
  <Section id="services" padding="lg">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow reveal">What we do</span>
      <h2 class="reveal mt-5 text-display-lg text-balance">
        Four practices.
        <span class="text-halo-soft">One outcome.</span>
      </h2>
      <p class="reveal mx-auto mt-5 max-w-prose text-pretty text-paper/70">
        Pick the area that's costing your team the most time today. We'll start there
        and prove the value before suggesting anything else.
      </p>
    </div>

    <ul class="mt-16 grid gap-5 md:grid-cols-2">
      {SERVICES.map((s, i) => (
        <li class="reveal" style={`transition-delay:${i * 60}ms`}>
          <a href={`/services/${s.slug}`} class="card group block h-full">
            <div class="flex items-start justify-between gap-4">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-halo-soft/15 bg-halo-soft/[0.04] text-halo-soft"
                style="filter: drop-shadow(0 0 6px rgba(254,249,231,0.18))"
              >
                <SparkMark size={18} />
              </div>
              <span class="eyebrow-mono text-paper/40">0{i + 1}</span>
            </div>

            <h3 class="mt-6 text-2xl text-balance text-paper">{s.title}</h3>
            <p class="mt-3 text-pretty text-paper/70">{s.blurb}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {s.keywords.map((k) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-paper/60">
                  {k}
                </span>
              ))}
            </div>

            <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-halo-soft transition-transform group-hover:translate-x-1">
              Read more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <div class="divider-line"></div>

  <!-- APPROACH ======================================================== -->
  <Section id="approach" padding="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <span class="eyebrow reveal">How we work</span>
        <h2 class="reveal mt-5 text-display-lg text-balance">
          The way we actually
          <span class="text-halo-soft">run a project.</span>
        </h2>
        <p class="reveal mt-5 text-pretty text-paper/70">
          A small senior team. You speak to the people who do the building. No account
          managers, no PowerPoint, no "AI strategy" decks. We get a useful workflow
          into production fast and iterate from there.
        </p>
        <a href="/about" class="reveal mt-8 inline-flex items-center gap-2 text-sm font-medium text-halo-soft hover:underline underline-offset-4">
          More about how we work
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid gap-4 sm:grid-cols-2">
          {principles.map((p, i) => (
            <li
              class="reveal rounded-2xl border border-white/[0.07] bg-white/[0.02] p-6"
              style={`transition-delay:${i * 80}ms`}
            >
              <div class="flex h-8 w-8 items-center justify-center rounded-md border border-halo-soft/15 bg-halo-soft/[0.06] font-display text-halo-soft">
                {i + 1}
              </div>
              <h3 class="mt-4 text-lg text-paper">{p.title}</h3>
              <p class="mt-2 text-sm text-pretty text-paper/65">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <div class="divider-line"></div>

  <!-- PROCESS ========================================================= -->
  <Section id="process" padding="lg">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow reveal">The engagement</span>
      <h2 class="reveal mt-5 text-display-lg text-balance">
        From first call to live workflow in
        <span class="text-halo-soft">weeks, not quarters.</span>
      </h2>
    </div>

    <ol class="relative mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-3">
      {[
        {
          step: "Discover",
          time: "Week 1",
          body: "A 30-minute call, then a short paid audit. You leave with a process map, an opportunity list ranked by ROI, and a fixed price for the build.",
        },
        {
          step: "Build",
          time: "Weeks 2 to 3",
          body: "We get the first automation into production. You see live runs, error handling and a runbook before we ever invoice for build time.",
        },
        {
          step: "Run",
          time: "Ongoing",
          body: "An optional retainer to monitor, extend and absorb the next round of work. Pause or cancel any month. You keep everything.",
        },
      ].map((p, i) => (
        <li class="reveal card" style={`transition-delay:${i * 80}ms`}>
          <div class="flex items-baseline justify-between">
            <span class="font-display text-3xl gradient-text-glow">0{i + 1}</span>
            <span class="eyebrow-mono text-paper/45">{p.time}</span>
          </div>
          <h3 class="mt-4 text-xl text-paper">{p.step}</h3>
          <p class="mt-2 text-pretty text-paper/70">{p.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- CTA ============================================================= -->
  <Section padding="xl">
    <div class="reveal relative overflow-hidden rounded-3xl border border-halo-soft/15 bg-gradient-to-br from-nocturne-lift via-nocturne to-nocturne-deep p-10 md:p-16">
      <div aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-halo-soft/[0.08] blur-3xl"></div>
      <div aria-hidden="true" class="absolute -bottom-24 -left-12 h-64 w-64 rounded-full bg-halo/[0.08] blur-3xl"></div>

      <div class="relative mx-auto max-w-2xl text-center">
        <h2 class="text-display-lg text-balance">
          Want to know where your team's hours are actually going?
        </h2>
        <p class="mt-5 text-pretty text-paper/75">
          Book a 30-minute call. Walk us through one process you'd like to automate
          and we'll tell you whether it's worth doing, what we'd build, and roughly
          what it would cost.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">Book a discovery call</a>
          <a href={`mailto:${SITE.email}`} class="btn-secondary">Or email us</a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
