---
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
  title?: string;
  blurb?: string;
}

const { steps, title = "How we solve it", blurb } = Astro.props;
---

<section aria-labelledby="steps-heading">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <span class="eyebrow">Approach</span>
      <h2 id="steps-heading" class="mt-4 text-display-lg text-balance">{title}</h2>
      {blurb && <p class="mt-5 text-pretty text-cloud/70">{blurb}</p>}
    </div>

    <ol class="lg:col-span-7 space-y-4">
      {steps.map((s, i) => (
        <li class="reveal flex gap-5 rounded-2xl border border-white/[0.07] bg-white/[0.02] p-6">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-starlight-200/15 bg-starlight-200/[0.06] font-display text-starlight-200">
            {i + 1}
          </div>
          <div>
            <h3 class="text-lg text-cloud">{s.title}</h3>
            <p class="mt-2 text-sm text-pretty text-cloud/70">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
