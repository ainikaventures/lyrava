---
import SparkMark from "./SparkMark.astro";

/**
 * Hero backdrop using the official brand sparkle geometry. Decorative only —
 * brand R6 ("one glow, never two") is satisfied because the page mark itself
 * is rendered flat. The bloom layer is a Halo-coloured radial wash, not a
 * recoloured mark.
 */
interface Props {
  /** Subtle mode dims everything for use behind dense content */
  subtle?: boolean;
}
const { subtle = false } = Astro.props;
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <!-- Warm Halo bloom at the top — atmosphere, not a mark -->
  <div
    class:list={[
      "absolute left-1/2 top-[-30%] h-[700px] w-[1100px] -translate-x-1/2 rounded-full bg-halo-radial blur-2xl",
      subtle && "opacity-60",
    ]}
  ></div>

  <!-- Cool starlight wash under the headline -->
  <div
    class:list={[
      "absolute left-1/2 top-[10%] h-[320px] w-[520px] -translate-x-1/2 rounded-full blur-2xl",
      subtle && "opacity-60",
    ]}
    style="background: radial-gradient(circle, rgba(255,241,201,0.10) 0%, transparent 70%);"
  ></div>

  <!-- Floating brand-geometry sparks — currentColor + drop shadow for soft glow -->
  <div
    class="absolute left-[7%] top-[16%] animate-twinkle text-paper/40"
    style="filter: drop-shadow(0 0 14px rgba(255,241,201,0.35))"
  >
    <SparkMark size={64} />
  </div>
  <div
    class="absolute right-[12%] top-[42%] animate-twinkle text-paper/30"
    style="animation-delay: 1.4s; filter: drop-shadow(0 0 10px rgba(255,241,201,0.3))"
  >
    <SparkMark size={40} />
  </div>
  <div
    class="absolute left-[22%] bottom-[14%] animate-twinkle text-paper/25"
    style="animation-delay: 2.6s; filter: drop-shadow(0 0 8px rgba(255,241,201,0.25))"
  >
    <SparkMark size={28} />
  </div>
  <div
    class="absolute right-[28%] bottom-[24%] animate-twinkle text-paper/20"
    style="animation-delay: 0.6s"
  >
    <SparkMark size={20} />
  </div>

  <!-- Faint grid for texture -->
  <svg class="absolute inset-0 h-full w-full opacity-[0.035]" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="grid" width="56" height="56" patternUnits="userSpaceOnUse">
        <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)" />
  </svg>
</div>
