---
import { SITE } from "@lib/site";
import { canonicalFor, absoluteUrl, organizationSchema, websiteSchema } from "@lib/seo";
import type { SEOProps } from "@lib/seo";

type Props = SEOProps & { jsonLd?: object[] };

const {
  title,
  description,
  path,
  ogImage = "/og-default.png",
  ogType = "website",
  noindex = false,
  publishedAt,
  updatedAt,
  author,
  keywords,
  jsonLd = [],
} = Astro.props;

const canonical = canonicalFor(path);
const ogImageUrl = absoluteUrl(ogImage);
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;

// Default JSON-LD on every page (Organization + WebSite); page-specific schemas
// are appended via the `jsonLd` prop.
const allSchemas = [organizationSchema(), websiteSchema(), ...jsonLd];
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Hreflang: same content, declared for both English markets + x-default -->
<link rel="alternate" hreflang="en-GB" href={canonical} />
<link rel="alternate" hreflang="en-US" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta property="og:locale:alternate" content="en_US" />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Author / generator -->
<meta name="author" content={SITE.name} />
<meta name="theme-color" content="#1a1033" />

<!-- Search Console (set value in src/lib/site.ts when ready) -->
{SITE.analytics.googleSiteVerification && (
  <meta name="google-site-verification" content={SITE.analytics.googleSiteVerification} />
)}

<!-- JSON-LD blobs -->
{allSchemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
