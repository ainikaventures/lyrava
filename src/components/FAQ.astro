---
// Accordion-style FAQ. Renders <details> for native keyboard + screen-reader
// support, and emits FAQPage JSON-LD so Google can show rich results.

interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  faqs: FAQItem[];
  title?: string;
  /** Set false on pages where you want to keep schema separate (rare) */
  emitSchema?: boolean;
}

const { faqs, title = "Frequently asked questions", emitSchema = true } = Astro.props;
---

<section aria-labelledby="faq-heading" class="mt-20">
  <div class="mx-auto max-w-3xl">
    <h2 id="faq-heading" class="text-display-lg text-balance text-center">{title}</h2>

    <div class="mt-12 divide-y divide-white/[0.07] border-y border-white/[0.07]">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary
            class="flex cursor-pointer list-none items-start justify-between gap-4 text-left"
          >
            <span class="text-lg font-medium text-cloud">{f.question}</span>
            <span
              aria-hidden="true"
              class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-cloud/70 transition-transform group-open:rotate-45"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 max-w-prose text-pretty text-cloud/70" set:html={f.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

{emitSchema && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: f.answer.replace(/<[^>]+>/g, ""),
        },
      })),
    })}
  />
)}
