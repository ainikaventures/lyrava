---
import Breadcrumbs from "./Breadcrumbs.astro";
import SparkBackdrop from "./SparkBackdrop.astro";

interface Props {
  eyebrow: string;
  title: string;
  /** the italic accent fragment of the title . appears after `title` in the H1 */
  accent?: string;
  lede: string;
  breadcrumbs: { name: string; href: string }[];
}

const { eyebrow, title, accent, lede, breadcrumbs } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <SparkBackdrop subtle={true} />
  <div class="container-wide pt-12 pb-20 md:pt-16 md:pb-28">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mx-auto mt-10 max-w-3xl text-center">
      <span class="eyebrow reveal">
        <span class="h-1.5 w-1.5 rounded-full bg-halo shadow-[0_0_8px_rgba(245,211,138,0.6)]"></span>
        {eyebrow}
      </span>
      <h1 class="reveal mt-6 text-display-xl text-balance text-paper">
        {title}
        {accent && <> <span class="gradient-text">{accent}</span></>}
      </h1>
      <p class="reveal mt-6 text-pretty text-lg text-paper/75 md:text-xl">{lede}</p>

      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/contact" class="btn-primary">Book a discovery call</a>
        <a href="/services" class="btn-secondary">All services</a>
      </div>
    </div>
  </div>
</section>
