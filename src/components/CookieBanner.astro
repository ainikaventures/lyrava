---
// GDPR-compliant cookie banner. Stores user choice in localStorage so it
// disappears on subsequent visits. Wired via plain JS . no third-party CMP.
---

<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  hidden
  class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-2xl rounded-2xl border border-white/10 bg-nocturne-deep/95 p-5 text-sm text-paper/85 shadow-card backdrop-blur md:inset-x-auto md:right-6 md:left-auto md:bottom-6"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center">
    <p class="flex-1 text-pretty">
      We use a small number of cookies to understand how the site is used. No tracking until you say yes.
      See our <a class="underline underline-offset-4 hover:text-halo-soft" href="/cookies">cookie policy</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-cookie-action="reject"
        class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-medium text-paper transition hover:bg-white/10"
      >
        Reject
      </button>
      <button
        type="button"
        data-cookie-action="accept"
        class="rounded-full bg-paper px-4 py-2 text-xs font-medium text-ink transition hover:shadow-starlight-sm"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "lyrava-cookie-consent";
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;
    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {
      // localStorage blocked → fail silent, keep banner hidden to avoid annoying users.
      return;
    }
    if (!stored) banner.removeAttribute("hidden");

    function persist(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      banner.setAttribute("hidden", "");
      // Hook for analytics: dispatch a custom event consumers can listen for
      window.dispatchEvent(new CustomEvent("lyrava:cookie-consent", { detail: value }));
    }

    banner.querySelectorAll("[data-cookie-action]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        persist(btn.getAttribute("data-cookie-action"));
      });
    });
  })();
</script>
