---
/**
 * Header / footer brand mark.
 *
 * Uses the official brand SVG assets — never the JPG. The wordmark already
 * includes the terminal sparkle (brand R2: "the sparkle is the dot"), so we
 * don't add a separate mark beside it.
 *
 * Variants:
 *   - "wordmark" (default) — wordmark only, ideal for header chrome
 *   - "lockup"             — mark card + wordmark, ideal for marketing surfaces
 *   - "mark"               — small standalone mark, e.g. tight footer slot
 */
interface Props {
  variant?: "wordmark" | "lockup" | "mark";
  height?: number;
  class?: string;
  href?: string;
}
const {
  variant = "wordmark",
  height = 28,
  class: className = "",
  href = "/",
} = Astro.props;

const src =
  variant === "lockup"
    ? "/brand/lyrava-lockup-horizontal.svg"
    : variant === "mark"
    ? "/brand/lyrava-mark-dark.svg"
    : "/brand/lyrava-wordmark-dark.svg";

// Native aspect ratios from the source SVGs
const ratio = variant === "lockup" ? 880 / 220 : variant === "mark" ? 1 : 720 / 200;
const width = Math.round(height * ratio);
---

<a
  href={href}
  class:list={["group inline-flex items-center", className]}
  aria-label="lyrava — home"
>
  <img
    src={src}
    alt="lyrava"
    width={width}
    height={height}
    style={`height:${height}px;width:${width}px`}
    decoding="async"
    class="block transition-opacity duration-200 group-hover:opacity-90"
  />
</a>
