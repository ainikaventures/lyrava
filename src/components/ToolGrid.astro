---
interface Tool {
  name: string;
  /** Short note: "core tool", "for scale", "optional" — keeps grid honest */
  tag?: string;
}
interface Props {
  tools: Tool[];
  title?: string;
  blurb?: string;
}

const { tools, title = "Tools we work in", blurb } = Astro.props;
---

<section aria-labelledby="tools-heading">
  <div class="mx-auto max-w-2xl text-center">
    <span class="eyebrow">Stack</span>
    <h2 id="tools-heading" class="mt-4 text-display-lg text-balance">{title}</h2>
    {blurb && <p class="mx-auto mt-4 max-w-prose text-pretty text-paper/70">{blurb}</p>}
  </div>

  <ul class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
    {tools.map((t) => (
      <li class="reveal rounded-xl border border-white/[0.07] bg-white/[0.025] px-4 py-4 text-center transition hover:border-halo-soft/20 hover:bg-white/[0.05]">
        <div class="text-sm font-medium text-paper">{t.name}</div>
        {t.tag && <div class="mt-1 text-xs text-paper/45">{t.tag}</div>}
      </li>
    ))}
  </ul>
</section>
